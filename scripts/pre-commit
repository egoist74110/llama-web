#!/bin/sh
# llama-web pre-commit: refuse data/ files and suspected secrets.
# Enable once per clone:  git config core.hooksPath scripts
# A line that is a deliberate fake (test fixture) can carry the marker "pre-commit:allow".
# Last resort: git commit --no-verify (do not use it for real keys).

fail=0

# 1. data/ must never be committed (runtime data, secrets.json, logs, binaries).
bad_paths=$(git -c core.quotepath=off diff --cached --name-only --diff-filter=ACMR |
  grep -E '(^|/)(data/|secrets\.json$|\.env($|\.))')
if [ -n "$bad_paths" ]; then
  echo "pre-commit: refusing to commit runtime data / secret files:" >&2
  echo "$bad_paths" | sed 's/^/  /' >&2
  fail=1
fi

# Names that usually hold a credential (case-insensitive): Cloudflare API token / key, CF_TOKEN, tunnel token ...
NAMES='(cloudflare|cf)[_-]?(api[_-]?)?(token|key)|api[_-]?token|tunnel[_-]?token|auth[_-]?token'
# 30+ credential characters right after such a name (and a few separator characters such as `": "`, ` = '`).
# A real token has digits; long identifiers and function calls (extractTokenFromPastedCommand(raw)) do not.
named_value() {
  printf '%s\n' "$1" | grep -Eio "($NAMES)[^A-Za-z0-9]{1,6}[A-Za-z0-9_.-]{30,}" | grep -q '[0-9]'
}
# The name ends the previous added line (`cloudflareToken:` / `= `), the value starts this one.
value_line() {
  printf '%s\n' "$1" | grep -Eio '^[^A-Za-z0-9]{0,6}[A-Za-z0-9_.-]{30,}' | grep -q '[0-9]'
}

# 2. Scan added lines for key-like strings: sk-..., long hex runs, Bearer tokens, tunnel tokens
#    (base64 starting eyJ), Cloudflare API token assignments and --token / TUNNEL_TOKEN values.
file=""
prev=""
hits=$(git -c core.quotepath=off diff --cached -U0 --no-color --diff-filter=ACMR |
  while IFS= read -r line; do
    case "$line" in
      '+++ b/'*) file=${line#'+++ b/'}; prev=""; continue ;;
      '@@'*) prev=""; continue ;;
      '+++'*|'---'*) continue ;;
      '+'*) ;;
      *) continue ;;
    esac
    body=${line#+}
    before=$prev
    prev=$body
    case "$body" in *pre-commit:allow*) continue ;; esac
    # review reports quote commit hashes (40 hex); only hex runs are skipped there.
    hexcheck=1
    case "$file" in docs/reviews/*) hexcheck=0 ;; esac
    reason=""
    if printf '%s\n' "$body" | grep -Eq '(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{20,}'; then
      reason="sk- style key"
    elif printf '%s\n' "$body" | grep -Eiq 'bearer[[:space:]]+[A-Za-z0-9._~+/=-]{20,}'; then
      reason="Bearer token"
    elif printf '%s\n' "$body" | grep -Eq 'eyJ[A-Za-z0-9+/_=-]{16,}'; then
      reason="tunnel token (base64) or JWT"
    elif named_value "$body"; then
      reason="Cloudflare / tunnel token assignment"
    elif printf '%s\n' "$before" | grep -Eiq "($NAMES)[^A-Za-z0-9]{0,6}\$" && value_line "$body"; then
      reason="Cloudflare / tunnel token on the line after its name"
    elif printf '%s\n' "$body" | grep -Eiq '(--token[= ]|TUNNEL_TOKEN=)[[:space:]]*[A-Za-z0-9+/_=-]{20,}'; then
      reason="tunnel token on a command line"
    elif [ "$hexcheck" = 1 ] && printf '%s\n' "$body" | grep -Eq '(^|[^A-Za-z0-9])[0-9a-fA-F]{32,}($|[^A-Za-z0-9])'; then
      reason="long hex string"
    fi
    if [ -n "$reason" ]; then
      echo "  $file: $reason"
    fi
  done)
if [ -n "$hits" ]; then
  echo "pre-commit: suspected secrets in staged changes (values not shown):" >&2
  echo "$hits" >&2
  echo "If this is a deliberate fake, add the marker pre-commit:allow to that line." >&2
  fail=1
fi

exit $fail
