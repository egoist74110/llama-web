{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "llama-web",
  "version": "../package.json",
  "identifier": "io.github.llama-web.desktop",
  "build": { "frontendDist": "../desktop/ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "launcher", "title": "llama-web", "width": 640, "height": 460, "resizable": false }],
    "security": {
      "capabilities": ["launcher"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "resources/": "resources/" },
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": false }
    }
  }
}
